  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a11d268343017544dafb9839a87a2fdf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InstructionBoard
  rightHandedSpot: {fileID: 1372600629}
  leftHandedSpot: {fileID: 621427937}
  screen: {fileID: 1632083883}
  labelText: {fileID: 1444491388}
  titleText: {fileID: 2125679860}
  bodyText: {fileID: 1737390956}
  panelColor: {r: 0.055, g: 0.075, b: 0.11, a: 1}
  viewer: {fileID: 669049099}
  labelDmm: 28
  titleMaxDmm: 52
  titleMinDmm: 36
  bodyMaxDmm: 40
  bodyMinDmm: 28
  slides:
  - step: 0
    label: WELCOME
    title: Welcome to the range
    body: Choose your shooting hand, then press START to walk to the shooting line.
    image: {fileID: 0}
  - step: 1
    label: STEP 1 OF 4
    title: Nock the arrow
    body: Hold the bow in your {bow} hand. With your {draw} hand take an arrow from the tube and bring its back end to the string. It clicks on.
    image: {fileID: 0}
  - step: 2
    label: STEP 2 OF 4
    title: Draw the string
    body: Put your {draw} hand on the string, squeeze and hold the trigger, then pull the string back to your face.
    image: {fileID: 0}
  - step: 3
    label: STEP 3 OF 4
    title: Aim
    body: Hold the draw at your face. Point the bow at the target and look through the sight.
    image: {fileID: 0}
  - step: 4
    label: STEP 4 OF 4
    title: Release
    body: When you are ready, let go of the trigger to loose the arrow.
    image: {fileID: 0}
  - step: 5
    label: ROUND COMPLETE
    title: That is all your arrows
    body: Press the ARROWS button on the table to bring them back to the tube. Shoot another round, or press EXIT to leave the line.
    image: {fileID: 0}
  firingAfter: 1.5
  previewStep: 0
